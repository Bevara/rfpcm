{
    "name": "rfpcm",
    "version": "1.0.1",
    "description": "PCM reframer",
    "filters":["rfpcm"],
    "help": "This filter parses raw PCM file/data or WAVE files and outputs corresponding raw audio.",
    "support": [
        "audio"
    ],
    "sources":"https://bevara.ddns.net/sources/rfpcm.accessor",
    "filter_source":{
        "rfpcm" : "reframe_rawpcm.c"
    },
    "Format": ["PCM"],
    "extension":{
      "wav" : "audio"
    },
    "using": ["solver_minimal_1", "solver_1"],
    "runtime": {
        "rfpcm": {
            "outputs": [
                {
                    "property": "GF_PROP_PID_AUDIO_FORMAT",
                    "format": [
                        "GF_AUDIO_FMT_FLT",
                        "GF_AUDIO_FMT_DBL",
                        "GF_AUDIO_FMT_U8",
                        "GF_AUDIO_FMT_S32",
                        "GF_AUDIO_FMT_S24",
                        "GF_AUDIO_FMT_S16"
                    ]
                }
            ]
        }
    },
    "patents": {
        "status": "royalty-free",
        "note": "raw PCM",
        "checked": "2026-10-16"
    }
}
